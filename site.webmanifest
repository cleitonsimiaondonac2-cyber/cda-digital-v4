    }
  ],
  "screenshots": [
    {
      "src": "img/screenshots/screenshot-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "CDA Digital Homepage"
    },
    {
      "src": "img/screenshots/screenshot-2.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "CDA Digital Mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Verificar Despachante",
      "short_name": "Verificar",
      "description": "Verificar se um despachante está registado",
      "url": "/verificar.html",
      "icons": [
        {
          "src": "img/icons/verify-icon.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Centro Documental",
      "short_name": "Documentos",
      "description": "Acessar legislação e documentos",
      "url": "/documentacao.html",
      "icons": [
        {
          "src": "img/icons/documents-icon.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Notícias",
      "short_name": "Notícias",
      "description": "Ver as últimas notícias",
      "url": "/noticias.html",
      "icons": [
        {
          "src": "img/icons/news-icon.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Contactos",
      "short_name": "Contactar",
      "description": "Contactar a CDA",
      "url": "/contactos.html",
      "icons": [
        {
          "src": "img/icons/contact-icon.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "protocol_handlers": [
    {
      "protocol": "web+cda",
      "url": "/handler?url=%s"
    }
  ],
  "handle_links": "preferred",
  "categories": ["business", "reference", "education"],
  "iarc_protocol_id": "CDA_DIGITAL_MZ"
}
